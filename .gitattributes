# Binary audio fixtures are stored with Git LFS.
# Run `git lfs install` once before adding any of these.
*.wav  filter=lfs diff=lfs merge=lfs -text
*.mp3  filter=lfs diff=lfs merge=lfs -text
*.m4a  filter=lfs diff=lfs merge=lfs -text
*.aac  filter=lfs diff=lfs merge=lfs -text
*.flac filter=lfs diff=lfs merge=lfs -text
*.caf  filter=lfs diff=lfs merge=lfs -text

# Golden binary artifacts from the DSP tests.
*.f32  filter=lfs diff=lfs merge=lfs -text
*.bin  filter=lfs diff=lfs merge=lfs -text

# Keep Swift diffs readable.
*.swift text diff=swift

# Shell scripts must check out with LF even where core.autocrlf is on.
# A Windows checkout otherwise hands WSL CRLF scripts, which fail with
# "bad interpreter" and exit 126 — reported from the Android work, and
# worth fixing here rather than with `tr -d '\r'` in each clone.
*.sh   text eol=lf
*.bash text eol=lf
