# Swift Package Manager
.build/
.build-linux/
.swiftpm/
Package.resolved

# Xcode
*.xcuserstate
xcuserdata/
DerivedData/
build/
*.xcodeproj/project.xcworkspace/xcuserdata/

# macOS
.DS_Store

# Generated test corpus — rebuilt by `corpus-gen`, never committed.
# The generator is deterministic, so the corpus is reproducible from source.
Tests/Fixtures/generated/

# Benchmark output. Trend files under Docs/benchmarks/ ARE committed;
# raw per-run reports are not.
*.bench.json

# Local model assets. Never committed — large, and license-encumbered.
#
# Anchored. Unanchored, this matched ANY directory called Models at any
# depth, and on a case-insensitive filesystem the lower-case rule below
# matched it too — which silently swallowed
# Sources/VoxScriptaCore/Models/ModelSearch.swift. The file built here and
# did not exist on GitHub, so every fresh clone failed to compile and this
# machine could not see it.
/Models/

# Fetched model weights — see Tools/fetch-model.sh
build/Model/

# Android cross-compile output
build/android-*

# Android Studio / Gradle
android/.gradle/
android/.idea/
android/local.properties
android/build/
android/app/build/
android/.cxx/
android/app/.cxx/
*.iml

# Staged by Tools/build-ffmpeg.sh from build/ffmpeg/<abi>/prefix/include, so
# that FFmpeg's headers sit under the one search path Swift is given for this
# target. Build output, not source: these were once committed symlinks, which
# a Windows checkout could not create without elevated privileges.
/Sources/CFFmpeg/include/libavcodec/
/Sources/CFFmpeg/include/libavformat/
/Sources/CFFmpeg/include/libavutil/
/Sources/CFFmpeg/include/libswresample/

# Fetched by Tools/fetch-whisper.sh, never committed.
third_party/whisper.cpp/
# Anchored, for the reason given above. Fetched weights live in build/models,
# which the build/ rule already covers.
/models/

# Xcode user state
ios/**/xcuserdata/
ios/**/*.xcworkspace/xcuserdata/

# Golden-diff artifacts, written by `flutter test` when a pixel test fails.
# Regenerated on every failure and meaningless once the golden is fixed.
flutter/app/test/failures/
